rules_version = '2';

// Every read/write in this app rides on the always-on session from
// firebase.ts - a real signed-in user, or the anonymous session it falls
// back to automatically on launch. So "request.auth != null" effectively
// means "opened through the app," and the write rules layer real
// ownership checks on top of that for anything sensitive.
service cloud.firestore {
  match /databases/{database}/documents {

    // socialAuth.ts: one profile doc per Firebase uid, keyed by uid.
    // Publicly readable (profile pages, "Find a Manager" lookups) - only
    // the account owner can create/update their own doc.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // socialAuth.ts: username -> uid lookup, doc id is the username
    // itself. Readable so signup can check availability and sign-in can
    // resolve a typed username to an email. Only the matching uid may
    // claim/overwrite a username doc.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // follows.ts: one doc per (follower, followed) relationship. Only the
    // follower can create or remove their own follow.
    match /follows/{relationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.followerUid == request.auth.uid;
    }

    // posts.ts: feed posts + matchup/trade comments, all in one
    // collection. Anyone signed in (incl. anonymous, read-only browsing)
    // can read. Creating a post must be as yourself, OR as the "system"
    // author used by ensureSystemPost for auto-announced trades/final
    // scores - any signed-in client may write those, matching how the
    // trades/matchup screens call it for whichever user happens to view
    // them first. Updates are restricted to just the like/repost/reply
    // counters, not the post content, so no one can rewrite someone
    // else's post while toggling a like.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.authorUid == request.auth.uid
            || request.resource.data.authorUid == "system");
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'repostCount', 'replyCount']);
      allow delete: if false;
    }

    // posts.ts: one doc per (post, user) like/repost relationship, doc id
    // "{postId}_{uid}". Only the owning uid can create/delete their own.
    match /postLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /postReposts/{repostId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
